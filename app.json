{
  "expo": {
    "name": "momentum-app",
    "slug": "momentum-app",
    "version": "1.0.0",
    "scheme": "momentum",
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#01BAEF"
        }
      ],
      "expo-font"
    ]
  }
}
